{
  "name": "testing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "gen:manifest": "node scripts/gen-pdf-manifest.js",
    "gen:blog-facts": "node scripts/gen-pdf-facts.js src/assets/pdfs/blogs",
    "gen:paper-facts": "node scripts/gen-pdf-facts.js src/assets/pdfs/papers",
    "gen": "npm run gen:manifest && npm run gen:blog-facts && npm run gen:paper-facts",
    "sync:pdfs": "node scripts/sync-pdfs.js --write",
    "check:pdfs": "node scripts/sync-pdfs.js",
    "check:topics": "node scripts/check-book-topics.js",
    "check:published": "node scripts/check-published-books.js",
    "check:blog": "node scripts/check-blog-posts.js",
    "check:papers": "node scripts/check-papers.js",
    "check": "npm run check:pdfs && npm run check:topics && npm run check:published && npm run check:blog && npm run check:papers",
    "prestart": "npm run gen",
    "start": "ng serve",
    "prebuild": "npm run gen && npm run check",
    "build": "ng build",
    "prewatch": "npm run gen",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@types/katex": "^0.16.8",
    "@types/sql.js": "^1.4.9",
    "bootstrap": "^5.2.3",
    "katex": "^0.16.47",
    "pdfjs-dist": "^2.14.305",
    "rxjs": "~7.5.0",
    "sql.js": "^1.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "~22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@types/jasmine": "~4.3.0",
    "angular-cli-ghpages": "^3.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~6.0.3"
  }
}
