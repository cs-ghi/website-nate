\[
  G/G_\Pi \cong \frac{G/G'}{G_\Pi/G'} \cong \frac{F^*}{\det G_\Pi}
\]


\begin{prop}{Properties of L-packets: II}{propofL-packetsII}
  Let \(\Pi\) be an irreducible smooth \(K\)-representation of \(G\) and \(\pi \in L(\Pi)\) be an irreducible component. Let \(G_\Pi\) denote the \(G\)-stabilizer of \(\pi\).
  \begin{enumerate}
    \item \(G_\Pi\) is the largest subgroup \(I\) of \(G\) such that \(\text{lg}(\Pi|_I) = \text{lg}(\Pi|_{G'})\).
    \item \(\Pi = \text{ind}_{G_\Pi}^G V_\pi\) where \(V_\pi\) is the space of \(\pi\).
    \item \(L(\Pi)\) is a principal homogeneous space (a \emph{torsor}) for \(G/G_\Pi\).
    \item \(|L(\Pi)|\) is a power of 2, and \(|L(\Pi)|\) divides \(2^{2+e}\) when \(\text{char}_F \neq 2\).
  \end{enumerate}
\end{prop}

\begin{Proof}
  \begin{enumerate}
    \item By~\cref{pr:propofL-packetsI}, the restriction \(\Pi|_{G'}\) has multiplicity 1. We apply~\cref{lm:lem3}(3), which states that when a restriction has multiplicity 1, the stabilizer \(G_\pi\) is the largest subgroup \(I\) containing \(H\) such that \(\text{lg}(\Pi|_I) = \text{lg}(\Pi|_H)\). Here, \(H = ZG'\). Since \(Z\) acts by scalars in \(\Pi\), restriction from \(H\) to \(G'\) does not change the length, so \(\text{lg}(\Pi|_H) = \text{lg}(\Pi|_{G'})\). Thus, \(G_\Pi\) is the largest subgroup maintaining the length of the restriction.

    \item Since \(G/H\) is compact (isomorphic to \(F^*/(F^*)^2\)), the index \([G:G_\Pi]\) is finite. By Clifford's theory (Section 2.2.6), \(V = \text{Ind}_{G_\Pi}^G(V_\pi)\). In the context of smooth representations with compact quotient, the smooth induction coincides with the compact induction, yielding \(\Pi \cong \text{ind}_{G_\Pi}^G V_\pi\).

    \item The group \(G\) acts transitively on the set of irreducible components \(L(\Pi)\) by conjugation. The stabilizer of any component \(\pi\) is \(G_\Pi\). Since \(G/G' \cong F^*\) is abelian, any subgroup containing \(G'\) is normal in \(G\), so \(G_\Pi\) is normal. Thus, the group \(G/G_\Pi\) acts simply transitively on \(L(\Pi)\).

    \item The cardinality is given by the index \(|L(\Pi)| = [G : G_\Pi]\). The determinant map \(\det: G \to
      F^*\) induces an isomorphism \(G/G_\Pi \cong F^*/\det G_\Pi\). Since \(Z\) acts by scalars on \(\Pi\),
      \(Z \subset G_\Pi\), and consequently \(\det(Z) = (F^*)^2 \subset \det G_\Pi\). Since \(\det G_\Pi\) is
      an open subgroup of \(F^*\) containing \((F^*)^2\), the index \([F^* : \det G_\Pi]\) divides \([F^* :
      (F^*)^2]\). By Equation~\ref{eq:4-1}, \(|F^*/(F^*)^2| = 2^{2+e}\) (for \(\text{char}_F \neq 2\)). Thus,
      \(|L(\Pi)|\) is a power of 2 dividing \(2^{2+e}\).
  \end{enumerate}
\end{Proof}


\begin{prop}{Size of L-packets}{sizeofL-packets}
  If $p$ is odd, then the cardinality of an $L$-packet is either $1$, $2$, or $4$.
\end{prop}

\begin{Proof}
  If $p$ is odd, then $|F^*/(F^*)^2| = 4$ as $\Char_F \ne 2$ (and hence $2$ doesn't ramify), giving the
  desired result.
\end{Proof}

