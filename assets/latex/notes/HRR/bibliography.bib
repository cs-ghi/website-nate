@article{lowreyGrothendieckRiemannRochDerivedSchemes2012,
  date = {2012-08-30},
  year = {2012},
  DOI = {10.48550/arXiv.1208.6325},
  archiveID = {arXiv:1208.6325},
  key = {USG2XNE2},
  repository = {arXiv},
  author = {Lowrey, Parker and Schürg, Timo},
  url = {http://arxiv.org/abs/1208.6325},
  libraryCatalog = {arXiv.org},
  title = {Grothendieck-Riemann-Roch for derived schemes},
  abstractNote = {We define bivariant algebraic K-theory and bivariant derived Chow on the homotopy category of derived schemes over a smooth base. The orientation on the latter corresponds to virtual Gysin homomorphisms. We then provide a morphism between these two bivariant theories and compare the two orientations. This comparison then yields a homological and cohomological Grothendieck-Riemann-Roch formula for virtual classes.},
  accessDate = {2025-08-30 01:33:31},
  extra = {arXiv:1208.6325 [math]},
}
@article{montpletRiemannRochIsometriesNoncompact2016,
  year = {2016},
  date = {2016-09-22},
  key = {38X6QK4K},
  DOI = {10.48550/arXiv.1604.00284},
  archiveID = {arXiv:1604.00284},
  url = {http://arxiv.org/abs/1604.00284},
  abstractNote = {We generalize work of Deligne and Gillet-Soul\'e on a Riemann-Roch type isometry, to the case of the trivial sheaf on cusp compactifications of Riemann surfaces $\Gamma\backslash\mathbb{H}$, for $\Gamma\subset PSL_{2}(\mathbb{R})$ a fuchsian group of the first kind, equipped with the Poincar\'e metric. This metric is singular at cusps and elliptic fixed points, and the results of Deligne and Gillet-Soul\'e do not apply to this setting. Our theorem relates the determinant of cohomology of the trivial sheaf, with an explicit Quillen type metric in terms of the Selberg zeta function of $\Gamma$, to a metrized version of the $\psi$ line bundle of the theory of moduli spaces of pointed orbicurves, and the self-intersection bundle of a suitable twist of the canonical sheaf $\omega_{X}$. We make use of surgery techniques through Mayer-Vietoris formulae for determinants of laplacians, in order to reduce to explicit evaluations of such for model hyperbolic cusps and cones. We derive an arithmetic Riemann-Roch formula, that applies in particular to integral models of modular curves with elliptic fixed points. As an application, we treat in detail the case of the modular curve $X(1)$. From this, we obtain the Selberg zeta special value $Z^{\prime}(1,PSL_{2}(\mathbb{Z}))$ in terms of logarithmic derivatives of Dirichlet $L$ functions. Our work finds its place in the program initiated by Burgos-Kramer-K\"uhn of extending arithmetic intersection theory to singular hermitian vector bundles.},
  extra = {arXiv:1604.00284 [math]},
  author = {Montplet, Gerard Freixas i and Pippich, Anna von},
  libraryCatalog = {arXiv.org},
  repository = {arXiv},
  title = {Riemann-Roch isometries in the non-compact orbifold setting},
}
