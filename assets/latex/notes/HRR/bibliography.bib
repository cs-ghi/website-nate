@unpublished{navarroRiemannRochFormulaProjective2017,
  date = {2017-05-30},
  year = {2017},
  title = {On the Riemann-Roch formula without projective hypothesis},
  url = {http://arxiv.org/abs/1705.10769},
  key = {5LCTDETD},
  archiveID = {arXiv:1705.10769},
  abstractNote = {Let $S$ be a finite dimensional noetherian scheme. For any proper morphism between smooth $S$-schemes, we prove a Riemann-Roch formula relating higher algebraic $K$-theory and motivic cohomology, thus with no projective hypothesis neither on the schemes nor on the morphism. We also prove, without projective assumptions, an arithmetic Riemann-Roch theorem involving Arakelov's higher $K$-theory and motivic cohomology as well as an analogue result for the relative cohomology of a morphism. These results are obtained as corollaries of a motivic statement that is valid for morphisms between oriented absolute spectra in the stable homotopy category of $S$.},
  repository = {arXiv},
  DOI = {10.48550/arXiv.1705.10769},
  extra = {arXiv:1705.10769 [math]},
  libraryCatalog = {arXiv.org},
  author = {Navarro, A. and Navarro, J.},
}
